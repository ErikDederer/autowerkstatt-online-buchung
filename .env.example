# Supabase project shared with WerkPlan (the workshop's admin dashboard,
# ../werkplan — see README.md "Verbindung zu WerkPlan"). Apply
# supabase/migrations/0001_booking_requests.sql to the project before
# setting these (WerkPlan's own migration creates the same table with
# CREATE TABLE IF NOT EXISTS, so either repo's migration can run first).
#
# SUPABASE_URL is the project's REST API URL (Project Settings -> API ->
# Project URL), NOT a Postgres connection string — createClient() in
# lib/supabase/admin.ts needs the https://xxx.supabase.co form.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It is read
# only in lib/supabase/admin.ts, which is imported exclusively from
# server actions ("use server" files) — never expose it with a
# NEXT_PUBLIC_ prefix or import it from a client component.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
